
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "declaration": false,
    "sourceMap": false,

    "removeComments": true
  },
  "include": [
    "solutions.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
